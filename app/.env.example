# RPC endpoint used by the frontend to talk to Solana devnet.
# Defaults to the public https://api.devnet.solana.com if unset, which is
# rate-limited and occasionally flaky ("blockhash not found" errors).
# A free devnet key from Helius, QuickNode, or Triton is recommended.
NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
