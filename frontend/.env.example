# Copy this file to .env.local and fill in the values.
# Anything starting with NEXT_PUBLIC_ is sent to every visitor's browser,
# so never put a secret or a private API key here.
#
# Address of the Solana devnet service the app talks to.
# The public address is shared and often slow, so a dedicated address is better.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
